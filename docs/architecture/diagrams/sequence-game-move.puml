@startuml
title Projeto Xadrez - Sequência game.move

autonumber
actor Jogador
participant "Frontend" as FE
participant "WebSocket Adapter" as WS
participant "Game Application" as APP
participant "Game Aggregate" as GAME
participant "Chess Engine" as CHESS
database "PostgreSQL" as DB
participant "Event Publisher Port" as EVENTS

Jogador -> FE: seleciona movimento
FE -> WS: game.move(gameId, requestId, uci, revision)
WS -> APP: move(sessão, requisição, revisão recebida)
APP -> DB: carregar partida com trava de linha
APP -> GAME: conferir participante humano
APP -> DB: buscar ação aceita por partida, sessão e requestId

alt reenvio idêntico
  APP -> WS: snapshot persistido atual
  WS -> FE: game.state correlacionado
else requestId usado por outra ação
  APP -> WS: REQUEST_ID_CONFLICT
  WS -> FE: game.error correlacionado
else ação nova sem revisão
  APP -> WS: VALIDATION_ERROR
  WS -> FE: game.error correlacionado
else primeiro envio
  APP -> GAME: move(sessão, uci, revisão recebida)
  GAME -> GAME: validar revisão, estado, relógio e turno
  alt fim por tempo
    GAME --> APP: partida encerrada e erro de negócio
    APP -> DB: persistir TIMEOUT
    DB --> APP: commit
    APP -> EVENTS: publicar TIMEOUT após commit a todos os inscritos
    APP --> WS: INVALID_GAME_STATE
    WS --> FE: game.error correlacionado
  else lance aceito
    GAME -> CHESS: validar e aplicar movimento
    GAME --> APP: estado atualizado
    APP -> DB: gravar ação aceita e estado na mesma transação
    DB --> APP: commit
    APP -> EVENTS: publicar snapshot após commit
    EVENTS -> WS: game.state para demais conexões inscritas
    APP -> WS: snapshot
    WS -> FE: game.state correlacionado
  else lance rejeitado
    GAME --> APP: erro de negócio
    APP --> WS: erro tipado
    WS --> FE: game.error correlacionado
  end
end
@enduml
